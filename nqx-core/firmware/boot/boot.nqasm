; NQX Boot ROM — bringup sequence
; Clears all registers, runs orthogonality self-test, halts.

; Step 1: BARRIER — ensure no pending DMA
BARRIER

; Step 2: Clear VRF (V0..V15) — write zeros via HBM load
; Load zero vector from HBM address 0 (pre-initialized to zeros)
LDV V0, [0x0]      ; V0 = zeros
MOV V1, V0
MOV V2, V0
MOV V3, V0
MOV V4, V0
MOV V5, V0
MOV V6, V0
MOV V7, V0
MOV V8, V0
MOV V9, V0
MOV V10, V0
MOV V11, V0
MOV V12, V0
MOV V13, V0
MOV V14, V0
MOV V15, V0

; Step 3: Clear SRF (S0..S7)
; Scalar regs are part of ENC state, implicitly cleared by HALT/reset

; Step 4: Orthogonality self-test
; Encode known vector and verify it decodes without error
; V0 still holds zeros — encode it
; (Full self-test requires a known-good vector and golden comparison;
;  emulator verifies invariants internally.)

; Step 5: HALT — boot complete
HALT
