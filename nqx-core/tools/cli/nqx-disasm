#!/usr/bin/env python3
"""Disassemble .bin bytecode → .nqasm text."""
import sys, os
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../.."))
from nqx.disassembler import disassemble_bytes

if len(sys.argv) != 3:
    print("Usage: nqx-disasm input.bin output.nqasm", file=sys.stderr)
    sys.exit(1)
with open(sys.argv[1], "rb") as f:
    text = disassemble_bytes(f.read())
with open(sys.argv[2], "w") as f:
    f.write(text + "\n")
print(f"disassembled {sys.argv[1]} -> {sys.argv[2]}")
